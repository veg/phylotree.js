{
  "name": "phylotree",
  "version": "2.6.1",
  "main": "dist/phylotree.js",
  "types": "dist/phylotree.d.ts",
  "unpkg": "dist/phylotree.js",
  "jsdelivr": "dist/phylotree.js",
  "module": "src/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "root-to-tip": "./bin/root-to-tip.js",
    "tag-branches": "./bin/phylotree-tag.js",
    "phylotree": "./bin/phylotree.js",
    "tip-date-extractor": "./bin/tip-date-extractor.js"
  },
  "keywords": [
    "phylogenetics",
    "phylogeny",
    "d3",
    "branching",
    "tree"
  ],
  "ignore": [
    "index.html"
  ],
  "dependencies": {
    "@types/d3": "^7.4.3",
    "commander": "^15.0.0",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.7.0",
    "moment": "^2.31.0",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdoc-to-markdown": "^9.1.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.65.0",
    "tape": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "lint": "eslint .",
    "dev": "rollup -w -c rollup.config.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "rollup -c rollup.config.mjs",
    "test": "node --enable-source-maps node_modules/tape/bin/tape --strict \"test/*-test.js\"",
    "typecheck": "tsc -p test/types",
    "docs:generate": "node scripts/docs.mjs generate",
    "docs:validate": "node scripts/docs.mjs validate",
    "docs:watch": "node scripts/docs.mjs watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist/phylotree.css",
    "dist/phylotree-menus.css",
    "dist/phylotree.js",
    "dist/phylotree.min.js",
    "dist/phylotree.d.ts",
    "bin",
    "src"
  ]
}
